# =======================================================
# ProxyQr Admin System Environment Variables Example
# Copy this file to .env and configure your production values
# =======================================================

# Admin Owner Email (For Brevo SMTP Delegated Proctor OTP Dispatch)
ADMIN_OWNER_EMAIL=admin@proxyqr.com

# Brevo SMTP Credentials (From Brevo Dashboard -> Transactional Emails -> SMTP Settings)
BREVO_SMTP_USER=your-brevo-account-email@domain.com
BREVO_SMTP_KEY=xsmtpsib-your-master-smtp-key

# Master Admin Password Hashed (bcrypt) or Plain Init Password
ADMIN_PASSWORD_INIT=2024BIT020@2026
ADMIN_PASSWORD_HASH=$2a$10$abcdef...

# JWT Secret Key
JWT_SECRET=proxyqr-super-secret-jwt-key-2026

# Frontend Deployment Public Base URL (Used for Dynamic QR Generation on Vercel)
# Example: https://proxyqr-system.vercel.app
VITE_APP_URL=https://proxyqr-system.vercel.app

# Backend API & WebSocket Server URLs
# Example: https://proxyqr-backend.onrender.com
VITE_BACKEND_URL=http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000
