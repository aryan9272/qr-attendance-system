# =======================================================
# ProxyQr Frontend Environment Variables Example
# Copy this file to .env and configure your production values
# =======================================================

# Google OAuth 2.0 Web Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=136625053294-olf8ok1trq36i3qbjt38vs4l8e84c1o2.apps.googleusercontent.com

# Frontend Deployment Public Base URL (Used for Dynamic QR Generation on Vercel)
# Example: https://proxyqr.vercel.app
VITE_APP_URL=https://proxyqr.vercel.app

# Backend API & WebSocket Server URLs
# Example: https://proxyqr-backend.onrender.com
VITE_BACKEND_URL=http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000
